# Copy to backend/.env and fill in. NEVER commit backend/.env.
# Every secret below is intentionally EMPTY here. `make keys` fills the generated
# ones in your local .env only if they are still empty, and never prints them.
APP_ENV=dev
APP_VERSION=0.2.0
# Host port 5433, not 5432: see docs/DECISIONS.md D-004 (a native postgres owns 5432 here).
DATABASE_URL=postgresql+psycopg://spasht:spasht@localhost:5433/spasht
CORS_ORIGINS=http://localhost:5173
# The origin the outside world reaches. Set to https://<your-ngrok-domain> for phone demos:
# receipt QR codes are built from this, never from the request Host header.
PUBLIC_BASE_URL=http://localhost:8000

# --- Sarvam AI (phase 7 onwards). The key lives ONLY here, never in a client. ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_FALLBACK_MODEL=bulbul:v3
SARVAM_LLM_LIVE_MODEL=sarvam-105b-conversations
SARVAM_LLM_OFFLINE_MODEL=sarvam-105b

# --- Firebase (phase 1) ---
FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json   # optional
DASHBOARD_ADMIN_EMAILS=                  # comma-separated; the email must be verified

# --- Trust layer (phase 6). `make keys` generates these. ---
SIGNING_KEY_PATH=./secrets/ed25519_private.key
SIGNING_KEY_ID=spasht-07
TRANSCRIPT_KEY=                          # base64 32 bytes, AES-256-GCM
CUSTOMER_REF_PEPPER=                     # random string, HMAC pepper
OTP_PEPPER=                              # random string, HMAC pepper
TTS_CACHE_SECRET=                        # random string, HMAC for audio cache keys

# --- Demo switches (dev only) ---
DEMO_MODE=false
DEMO_AUTH=false
# Demo auth needs ALL of: DEMO_AUTH=true, APP_ENV=dev, and the caller sending a
# matching X-Demo-Key. `make keys` generates one. Never ships in an iOS Release build.
DEMO_AUTH_KEY=
OTP_DEMO=false

# --- Phone tunnel (phase 13) ---
NGROK_DOMAIN=                            # your free ngrok static domain, no scheme

# --- Rescue agent (phase 10) ---
RESCUE_IDLE_SECONDS=60
CONTACT_WINDOW=09:00-18:00
