# Copy to backend/.env and fill in. NEVER commit backend/.env.
APP_ENV=dev
APP_VERSION=0.1.0
# Host port 5433, not 5432: see docs/DECISIONS.md (a native postgres owns 5432 here).
DATABASE_URL=postgresql+psycopg://spasht:spasht@localhost:5433/spasht
CORS_ORIGINS=http://localhost:5173

# --- Sarvam AI (phase 6 onwards) ---
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_FALLBACK_MODEL=bulbul:v3
SARVAM_LLM_LIVE_MODEL=sarvam-105b-conversations
SARVAM_LLM_OFFLINE_MODEL=sarvam-105b

# --- Firebase (phase 1) ---
FIREBASE_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=          # optional: ./secrets/firebase-service-account.json
DASHBOARD_ADMIN_EMAILS=                  # comma-separated

# --- Trust layer (phase 5). `make keys` fills the three secrets below. ---
SIGNING_KEY_PATH=./secrets/ed25519_private.key
SIGNING_KEY_ID=spasht-07
TRANSCRIPT_KEY=                          # base64 32 bytes
CUSTOMER_REF_PEPPER=                     # random string
TTS_CACHE_SECRET=                        # random string

# --- Demo switches ---
DEMO_MODE=false
DEMO_AUTH=false
OTP_DEMO=true

# --- Rescue agent (phase 9) ---
RESCUE_IDLE_SECONDS=60
CONTACT_WINDOW=09:00-18:00
