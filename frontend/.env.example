# Copy to frontend/.env and fill in. NEVER commit frontend/.env.
# This is the laptop website only (admin dashboard + receipt check). The customer
# side is the native iOS app, configured in ios/Config/Secrets.xcconfig.
#
# `/api` is proxied to the backend by the Vite dev server (see vite.config.ts).
VITE_API_BASE_URL=/api

# --- Firebase web app (phase 1): Firebase console > Project settings > Your apps ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Shows "Continue as demo admin" on the login screen. Dev only, and the key must
# match DEMO_AUTH_KEY in backend/.env or the backend returns 401.
VITE_DEMO_AUTH=false
VITE_DEMO_AUTH_KEY=
