// Copy to ios/Config/Secrets.xcconfig and fill in. That file is GITIGNORED.
//
//     cp ios/Config/Secrets.example.xcconfig ios/Config/Secrets.xcconfig
//     make ios-config        # fills GOOGLE_REVERSED_CLIENT_ID and the demo key
//
// Every value here is empty or a local default on purpose. Nothing secret is
// ever committed (build plan section 13.3).
//
// xcconfig treats "//" as a comment, so URLs must be written with an empty
// variable reference breaking the slashes:   https:/$()/host

// Where the app finds the backend.
//   Simulator : http:/$()/localhost:8000
//   iPhone    : https:/$()/<your-ngrok-domain>      (see `make tunnel`)
API_BASE_URL = http:/$()/localhost:8000

// The origin used to build receipt QR links. On a phone demo this must be the
// ngrok HTTPS domain, or a judge scanning the QR reaches nothing.
PUBLIC_BASE_URL = http:/$()/localhost:8000

// Must match DEMO_AUTH_KEY in backend/.env. `make ios-config` copies it across.
// Debug builds only - Release.xcconfig blanks it whatever is written here.
DEMO_AUTH_KEY =

// From ios/SpashtPaytm/Config/GoogleService-Info.plist (REVERSED_CLIENT_ID).
// `make ios-config` reads it with PlistBuddy. Google sign-in needs it as a
// custom URL scheme; while it is empty the Google button stays hidden.
GOOGLE_REVERSED_CLIENT_ID =

// Xcode > Settings > Accounts > your Apple ID. A free "Personal Team" is fine.
// Keeping it here means `make ios-gen` never loses your signing setup.
DEVELOPMENT_TEAM =

// Change this if Xcode says the identifier is unavailable; it must then match
// the bundle ID registered in the Firebase console.
PRODUCT_BUNDLE_IDENTIFIER = com.finovators.spashtpaytm
